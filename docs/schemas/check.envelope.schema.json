{
  "$comment": "Frozen SPEC-02 envelope only; use check.schema.json for pack-owned `with` validation.",
  "$defs": {
    "CompetencyCheck": {
      "additionalProperties": false,
      "properties": {
        "expect": {
          "$ref": "#/$defs/Expect"
        },
        "generated": {
          "default": false,
          "title": "Generated",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "default": {},
          "title": "Params",
          "type": "object"
        },
        "provenance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance"
        },
        "query": {
          "description": "Read-only Cypher. Findings require a returned graph entity, typed pointer, or explicit node_element_id, rel_element_id, or relationship_element_id alias containing elementId(). Business IDs and arbitrary *_id columns are not evidence pointers; a scalar count alone cannot supply evidence for a failed assertion.",
          "title": "Query",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/SuiteSeverity",
          "default": null
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "question",
        "query",
        "expect"
      ],
      "title": "CompetencyCheck",
      "type": "object"
    },
    "ConformanceCheck": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "title": "Check",
          "type": "string"
        },
        "generated": {
          "default": false,
          "title": "Generated",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance"
        },
        "severity": {
          "$ref": "#/$defs/SuiteSeverity",
          "default": null
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "with": {
          "additionalProperties": true,
          "title": "With",
          "type": "object"
        }
      },
      "required": [
        "id",
        "check",
        "with"
      ],
      "title": "ConformanceCheck",
      "type": "object"
    },
    "Defaults": {
      "additionalProperties": false,
      "properties": {
        "severity": {
          "$ref": "#/$defs/SuiteSeverity",
          "default": null
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "title": "Defaults",
      "type": "object"
    },
    "DriftCheck": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "default": "latest",
          "title": "Baseline",
          "type": "string"
        },
        "generated": {
          "default": false,
          "title": "Generated",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance"
        },
        "severity": {
          "$ref": "#/$defs/SuiteSeverity",
          "default": null
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "target": {
          "additionalProperties": true,
          "title": "Target",
          "type": "object"
        },
        "tolerance": {
          "additionalProperties": true,
          "title": "Tolerance",
          "type": "object"
        }
      },
      "required": [
        "id",
        "metric",
        "target",
        "tolerance"
      ],
      "title": "DriftCheck",
      "type": "object"
    },
    "Expect": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "contains": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required regression values; other returned values are allowed. For one result column, list that column's values directly (e.g. [ACC-1]), not row maps or nested row lists. For multiple columns, use complete column-to-value maps.",
          "title": "Contains"
        },
        "empty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Empty"
        },
        "equals": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Complete regression result as an order-independent, duplicate-preserving bag. For one result column, list values directly (e.g. [1500]); for multiple columns, use complete column-to-value maps. A failed assertion still requires a real graph evidence pointer.",
          "title": "Equals"
        },
        "rows": {
          "anyOf": [
            {
              "$ref": "#/$defs/RowBounds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unique": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unique"
        }
      },
      "title": "Expect",
      "type": "object"
    },
    "RowBounds": {
      "additionalProperties": false,
      "properties": {
        "exactly": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exactly"
        },
        "max": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        }
      },
      "title": "RowBounds",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "error",
        "warn"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SuiteSeverity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Severity"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "competency": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CompetencyCheck"
      },
      "title": "Competency",
      "type": "array"
    },
    "conformance": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ConformanceCheck"
      },
      "title": "Conformance",
      "type": "array"
    },
    "defaults": {
      "$ref": "#/$defs/Defaults",
      "default": {
        "severity": null,
        "tags": []
      }
    },
    "drift": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DriftCheck"
      },
      "title": "Drift",
      "type": "array"
    },
    "generated": {
      "default": false,
      "title": "Generated",
      "type": "boolean"
    },
    "suite": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suite"
    }
  },
  "title": "_SuiteFile",
  "type": "object"
}
