                }
              },
              "required": [
                "label",
                "property",
                "type"
              ],
              "title": "PropertyTypeWith",
              "type": "object"
            }
          },
          "required": [
            "check",
            "with"
          ]
        },
        {
          "properties": {
            "check": {
              "const": "rel_direction"
            },
            "with": {
              "additionalProperties": false,
              "properties": {
                "from_label": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "From Label",
                  "type": "string"
                },
                "rel_type": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Rel Type",
                  "type": "string"
                },
                "to_label": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "To Label",
                  "type": "string"
                }
              },
              "required": [
                "from_label",
                "rel_type",
                "to_label"
              ],
              "title": "RelDirectionWith",
              "type": "object"
            }
          },
          "required": [
            "check",
            "with"
          ]
        },
        {
          "properties": {
            "check": {
              "const": "temporal_sanity"
            },
            "with": {
              "additionalProperties": false,
              "properties": {
                "end_property": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "End Property",
                  "type": "string"
                },
                "label": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Label",
                  "type": "string"
                },
                "start_property": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Start Property",
                  "type": "string"
                }
              },
              "required": [
                "label",
                "start_property",
                "end_property"
              ],
              "title": "TemporalSanityWith",
              "type": "object"
            }
          },
          "required": [
            "check",
            "with"
          ]
        },
        {
          "properties": {
            "check": {
              "const": "uniqueness"
            },
            "with": {
              "additionalProperties": false,
              "properties": {
                "label": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Label",
                  "type": "string"
                },
                "property": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Property",
                  "type": "string"
                }
              },
              "required": [
                "label",
