        "expect": {
          "$ref": "#/$defs/Expect"
        },
        "generated": {
          "default": false,
          "title": "Generated",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "default": {},
          "title": "Params",
          "type": "object"
        },
        "provenance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/SuiteSeverity",
          "default": null
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "question",
        "query",
        "expect"
      ],
      "title": "CompetencyCheck",
      "type": "object"
    },
    "ConformanceCheck": {
      "allOf": [
        {
          "$ref": "#/$defs/ConformanceCheckBase"
        },
        {
          "$ref": "#/$defs/WithByCheck"
        }
      ]
    },
    "ConformanceCheckBase": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "title": "Check",
          "type": "string"
        },
        "generated": {
          "default": false,
          "title": "Generated",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance"
        },
        "severity": {
          "$ref": "#/$defs/SuiteSeverity",
          "default": null
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "with": {
          "additionalProperties": true,
          "title": "With",
          "type": "object"
        }
      },
      "required": [
        "id",
        "check",
        "with"
      ],
      "title": "ConformanceCheck",
      "type": "object"
    },
    "Defaults": {
      "additionalProperties": false,
      "properties": {
        "severity": {
          "$ref": "#/$defs/SuiteSeverity",
          "default": null
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "title": "Defaults",
      "type": "object"
    },
    "DriftCheck": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "default": "latest",
          "title": "Baseline",
          "type": "string"
        },
        "generated": {
          "default": false,
          "title": "Generated",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance"
        },
        "severity": {
          "$ref": "#/$defs/SuiteSeverity",
          "default": null
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "target": {
          "additionalProperties": true,
          "title": "Target",
          "type": "object"
        },
        "tolerance": {
          "additionalProperties": true,
          "title": "Tolerance",
          "type": "object"
        }
      },
      "required": [
        "id",
        "metric",
        "target",
        "tolerance"
      ],
      "title": "DriftCheck",
      "type": "object"
    },
    "Expect": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "contains": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contains"
        },
        "empty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Empty"
        },
        "equals": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equals"
        },
        "rows": {
          "anyOf": [
            {
              "$ref": "#/$defs/RowBounds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unique": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unique"
        }
      },
      "title": "Expect",
      "type": "object"
    },
    "RowBounds": {
      "additionalProperties": false,
      "properties": {
        "exactly": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exactly"
        },
        "max": {
          "anyOf": [
            {
              "type": "integer"
