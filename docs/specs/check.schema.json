    "SuiteSeverity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Severity"
        },
        {
          "type": "null"
        }
      ]
    },
    "WithByCheck": {
      "oneOf": [
        {
          "properties": {
            "check": {
              "const": "cardinality"
            },
            "with": {
              "additionalProperties": false,
              "properties": {
                "direction": {
                  "default": "out",
                  "enum": [
                    "out",
                    "in",
                    "any"
                  ],
                  "title": "Direction",
                  "type": "string"
                },
                "exactly": {
                  "default": 1,
                  "minimum": 0,
                  "title": "Exactly",
                  "type": "integer"
                },
                "from_label": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "From Label",
                  "type": "string"
                },
                "rel_type": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Rel Type",
                  "type": "string"
                },
                "to_label": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "To Label",
                  "type": "string"
                }
              },
              "required": [
                "from_label",
                "rel_type",
                "to_label"
              ],
              "title": "CardinalityWith",
              "type": "object"
            }
          },
          "required": [
            "check",
            "with"
          ]
        },
        {
          "properties": {
            "check": {
              "const": "completeness"
            },
            "with": {
              "additionalProperties": false,
              "properties": {
                "label": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Label",
                  "type": "string"
                },
                "property": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Property",
                  "type": "string"
                },
                "threshold": {
                  "default": 1.0,
                  "exclusiveMinimum": 0.0,
                  "maximum": 1.0,
                  "title": "Threshold",
                  "type": "number"
                }
              },
              "required": [
                "label",
                "property"
              ],
              "title": "CompletenessWith",
              "type": "object"
            }
          },
          "required": [
            "check",
            "with"
          ]
        },
        {
          "properties": {
            "check": {
              "const": "dangling_rels"
            },
            "with": {
              "additionalProperties": false,
              "properties": {
                "rel_type": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "pattern": "\\S",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Rel Type"
                }
              },
              "title": "DanglingRelsWith",
              "type": "object"
            }
          },
          "required": [
            "check",
            "with"
          ]
        },
        {
          "properties": {
            "check": {
              "const": "hub_outlier"
            },
            "with": {
              "additionalProperties": false,
              "properties": {
                "direction": {
                  "default": "any",
                  "enum": [
                    "out",
                    "in",
                    "any"
                  ],
                  "title": "Direction",
                  "type": "string"
                },
                "label": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Label",
                  "type": "string"
                },
                "rel_type": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "pattern": "\\S",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Rel Type"
                },
                "sample_size": {
                  "anyOf": [
                    {
                      "exclusiveMinimum": 0,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Sample Size"
                },
                "z_threshold": {
                  "default": 3.0,
                  "exclusiveMinimum": 0.0,
                  "title": "Z Threshold",
                  "type": "number"
                }
              },
              "required": [
                "label"
              ],
              "title": "HubOutlierWith",
              "type": "object"
            }
          },
          "required": [
            "check",
            "with"
          ]
        },
        {
          "properties": {
            "check": {
              "const": "label_cooccurrence"
            },
            "with": {
              "additionalProperties": false,
              "properties": {
                "label_a": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Label A",
                  "type": "string"
                },
                "label_b": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Label B",
                  "type": "string"
                }
              },
              "required": [
                "label_a",
                "label_b"
              ],
              "title": "LabelCooccurrenceWith",
              "type": "object"
            }
          },
          "required": [
            "check",
            "with"
          ]
        },
        {
          "properties": {
            "check": {
              "const": "no_orphans"
            },
            "with": {
              "additionalProperties": false,
              "properties": {
                "direction": {
                  "default": "any",
                  "enum": [
                    "out",
                    "in",
                    "any"
                  ],
                  "title": "Direction",
                  "type": "string"
                },
                "label": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Label",
                  "type": "string"
                },
                "rel_type": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "pattern": "\\S",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Rel Type"
                }
              },
              "required": [
                "label"
              ],
              "title": "NoOrphansWith",
              "type": "object"
            }
          },
          "required": [
            "check",
            "with"
          ]
        },
        {
          "properties": {
            "check": {
              "const": "property_format"
            },
            "with": {
              "additionalProperties": false,
              "properties": {
                "label": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Label",
                  "type": "string"
                },
                "property": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Property",
                  "type": "string"
                },
                "regex": {
                  "format": "regex",
                  "minLength": 1,
                  "title": "Regex",
                  "type": "string"
                }
              },
              "required": [
                "label",
                "property",
                "regex"
              ],
              "title": "PropertyFormatWith",
              "type": "object"
            }
          },
          "required": [
            "check",
            "with"
          ]
        },
        {
          "properties": {
            "check": {
              "const": "property_type"
            },
            "with": {
              "additionalProperties": false,
              "properties": {
                "label": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Label",
                  "type": "string"
                },
