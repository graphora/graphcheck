            "with": {
              "additionalProperties": false,
              "properties": {
                "label": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Label",
                  "type": "string"
                },
                "property": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Property",
                  "type": "string"
                },
                "values": {
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
